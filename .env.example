# Variáveis de ambiente
# - No computador: copie para .env e preencha. NUNCA publique o .env.
# - Na Vercel: cadastre em Settings → Environment Variables (Production).

# Painel SigiloPay → Integrações → API → Gerar credenciais
# A credencial precisa da permissão PRODUCER_TRANSACTIONS
SIGILOPAY_PUBLIC_KEY=SUA_CHAVE_PUBLICA
SIGILOPAY_SECRET_KEY=SUA_CHAVE_SECRETA

# Endereço público da loja, com https. A SigiloPay manda o webhook para
# PUBLIC_URL + /api/webhook/sigilopay
# Na Vercel, se ficar vazio, usa o domínio de produção do projeto.
PUBLIC_URL=https://www.sualoja.com.br

# Só para o servidor local
PORT=3000
# Use 1 se o servidor local estiver atrás de proxy (Nginx, Cloudflare)
TRUST_PROXY=0
